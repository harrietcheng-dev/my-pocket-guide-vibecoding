.settings-page { padding-bottom: 60rpx; }
.menu-card { padding: 6rpx 24rpx 14rpx; }
.menu-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #edf2f4; }
.menu-row:last-child { border-bottom: 0; }
.menu-main { flex: 1; min-width: 0; }
.menu-title { color: #1f2937; font-size: 28rpx; font-weight: 600; }
.menu-title.danger-text { color: #b42318; }
.menu-desc { margin-top: 6rpx; font-size: 21rpx; line-height: 1.5; }
.menu-side { display: flex; flex: 0 0 auto; align-items: center; gap: 10rpx; }
.menu-arrow { color: #98a2b3; font-size: 30rpx; }
.perm-state { color: #98a2b3; font-size: 23rpx; }
.perm-state.on { color: #0f9d58; font-weight: 600; }
.privacy-note { margin: 6rpx 0 20rpx; padding: 20rpx; border-radius: 16rpx; color: #07517a; background: #eaf7fb; font-size: 24rpx; font-weight: 600; }
.privacy-note text { display: block; margin-top: 8rpx; color: #39718b; font-size: 21rpx; font-weight: 400; line-height: 1.6; }
.panel-body { margin: 0 0 18rpx; padding: 22rpx; border-radius: 18rpx; color: #475467; background: #f4f9fb; font-size: 23rpx; line-height: 1.75; white-space: pre-wrap; }
.label { margin: 24rpx 0 12rpx; color: #07517a; font-weight: 600; }
.choice { display: inline-block; margin: 0 12rpx 12rpx 0; padding: 12rpx 22rpx; border: 2rpx solid #73c8d8; border-radius: 999rpx; color: #07517a; font-size: 24rpx; }
.choice.active { color: #ffffff; background: #1677e8; border-color: #1677e8; }
.textarea { box-sizing: border-box; width: 100%; min-height: 180rpx; padding: 20rpx; border: 1rpx solid #d5dce0; border-radius: 14rpx; background: #fff; font-size: 25rpx; }
.derived-tip { margin: 12rpx 0 6rpx; color: #667085; font-size: 21rpx; line-height: 1.6; }
.panel-body .primary-button { margin-top: 20rpx; }
.about-card { text-align: center; }
.about-name { color: #07517a; font-size: 34rpx; font-weight: 800; }
.about-version { margin-top: 10rpx; color: #667085; font-size: 23rpx; }
.about-slogan { margin-top: 14rpx; color: #ff902f; font-size: 25rpx; font-weight: 600; }
