.subtitle { margin: 10rpx 0 26rpx; }
.row { display: flex; justify-content: space-between; gap: 24rpx; padding: 22rpx 0; border-bottom: 1rpx solid #edf1f3; }
.row text:first-child { color: #667085; }
.row text:last-child { flex: 1; text-align: right; font-weight: 600; }
.notice { margin-top: 22rpx; padding: 22rpx; border-radius: 16rpx; color: #8a4b0f; background: #fff8e8; line-height: 1.6; }
