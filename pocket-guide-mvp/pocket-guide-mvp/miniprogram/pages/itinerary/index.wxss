.topline { display: flex; justify-content: space-between; align-items: flex-start; }
.adjusted { margin-top: 22rpx; padding: 20rpx; color: #8a4b0f; background: #fff8e8; border-radius: 16rpx; }
.day-tabs { margin: 28rpx 0 18rpx; white-space: nowrap; }
.day-tab { display: inline-block; margin-right: 14rpx; padding: 14rpx 28rpx; color: #07517a; background: #eaf7fb; border-radius: 999rpx; }
.day-tab.active { color: #ffffff; background: #1677e8; }
.day-summary { display: flex; justify-content: space-between; padding-bottom: 22rpx; color: #667085; border-bottom: 1rpx solid #edf1f3; }
.node { display: grid; grid-template-columns: 88rpx 34rpx 1fr; padding-top: 24rpx; }
.time { font-weight: 600; }
.timeline { position: relative; border-left: 3rpx solid #73c8d8; }
.timeline-dot { position: absolute; left: -11rpx; width: 18rpx; height: 18rpx; border: 3rpx solid #ffffff; border-radius: 12rpx; background: #1677e8; }
.node-body { padding-bottom: 28rpx; }
.node-head { display: flex; align-items: center; font-size: 31rpx; font-weight: 700; }
.node-head .pill { margin: 0 0 0 12rpx; font-size: 22rpx; }
.meta { margin-top: 12rpx; color: #07517a; font-size: 24rpx; }
.budget { margin-top: 22rpx; line-height: 1.8; }
.budget-title { margin-top: 0; }
