.home-page { background: linear-gradient(180deg, #dff5ff 0, #f7fbfd 430rpx); }
.home-head { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 26rpx; }.home-eyebrow { color: #1677e8; font-size: 18rpx; font-weight: 800; letter-spacing: 3rpx; }.home-title { margin: 8rpx 0 6rpx; color: #07517a; font-size: 42rpx; font-weight: 800; }.home-head .muted { font-size: 23rpx; }
.mini-guide { position: relative; }.mini-guide-face { width: 88rpx; height: 88rpx; border: 6rpx solid #fff; border-radius: 30rpx; line-height: 88rpx; text-align: center; color: #fff; background: linear-gradient(145deg, #ffae5e, #ff7f46); box-shadow: 0 12rpx 26rpx rgba(7,81,122,.15); font-size: 34rpx; font-weight: 800; }.online-dot { position: absolute; right: -2rpx; bottom: -2rpx; width: 20rpx; height: 20rpx; border: 5rpx solid #fff; border-radius: 50%; background: #20a77a; }
.hero-panel { padding: 30rpx; border-radius: 32rpx; color: #fff; background: linear-gradient(145deg, #0876bd, #23a1ce); box-shadow: 0 18rpx 42rpx rgba(7,81,122,.2); }.hero-kicker { font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; opacity: .85; }.hero-title { margin-top: 12rpx; max-width: 580rpx; font-size: 36rpx; font-weight: 800; line-height: 1.35; }.hero-copy { margin-top: 10rpx; font-size: 23rpx; line-height: 1.55; opacity: .86; }.hero-actions { display: flex; gap: 14rpx; margin-top: 26rpx; }.hero-actions button { flex: 1; height: 72rpx; margin: 0; padding: 0; border-radius: 18rpx; line-height: 72rpx; font-size: 24rpx; font-weight: 700; }.create-trip { color: #07517a; background: #fff; }.voice-plan { color: #fff; background: rgba(255,255,255,.18); }
.dashboard-loading { margin-top: 22rpx; }.dashboard-loading view { height: 110rpx; margin-top: 14rpx; border-radius: 24rpx; background: linear-gradient(90deg,#e8f1f4 25%,#f7fafb 38%,#e8f1f4 63%); background-size: 400% 100%; animation: shimmer 1.4s ease infinite; }.dashboard-loading view:first-child { height: 350rpx; }.dashboard-error { display: flex; justify-content: space-between; margin-top: 22rpx; padding: 24rpx; border-radius: 20rpx; color: #b54708; background: #fff4e8; font-size: 23rpx; }.dashboard-error text:last-child { color: #1677e8; font-weight: 800; }
.active-trip-card { margin-top: 22rpx; padding: 28rpx; border: 1rpx solid #cde5ef; border-radius: 30rpx; background: #fff; box-shadow: 0 15rpx 36rpx rgba(7,81,122,.09); }.active-card-head { display: flex; justify-content: space-between; gap: 20rpx; }.active-kicker { color: #168f70; font-size: 21rpx; font-weight: 800; }.active-kicker text { display: inline-block; width: 13rpx; height: 13rpx; margin-right: 7rpx; border-radius: 50%; background: #20a77a; }.active-title { margin-top: 9rpx; color: #07517a; font-size: 35rpx; font-weight: 800; }.active-date { margin-top: 6rpx; color: #667085; font-size: 21rpx; }.progress-number { color: #1677e8; font-size: 35rpx; font-weight: 800; }.active-progress { height: 12rpx; margin-top: 23rpx; overflow: hidden; border-radius: 999rpx; background: #e2edf2; }.active-progress view { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg,#20a77a,#1677e8); }.active-progress-meta { display: flex; justify-content: space-between; margin-top: 9rpx; color: #667085; font-size: 20rpx; }.next-stop { display: flex; align-items: center; margin-top: 22rpx; padding: 18rpx; border-radius: 20rpx; background: #f2fafb; }.next-stop-icon { flex: 0 0 58rpx; height: 58rpx; margin-right: 15rpx; border-radius: 18rpx; line-height: 58rpx; text-align: center; color: #1677e8; background: #e2f1ff; font-size: 29rpx; }.next-stop-main { flex: 1; }.next-stop-main view { color: #667085; font-size: 19rpx; }.next-stop-main text { display: block; margin-top: 4rpx; color: #1f2937; font-size: 27rpx; font-weight: 800; }.next-stop-time { color: #39718b; font-size: 20rpx; }.continue-button { height: 76rpx; margin-top: 20rpx; border-radius: 18rpx; line-height: 76rpx; color: #fff; background: #1677e8; font-size: 26rpx; font-weight: 700; }
.no-active-card { display: flex; align-items: center; gap: 18rpx; margin-top: 22rpx; padding: 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(7,81,122,.06); }.no-active-icon { flex: 0 0 62rpx; height: 62rpx; border-radius: 20rpx; line-height: 62rpx; text-align: center; color: #168f70; background: #dcfae6; font-size: 31rpx; font-weight: 800; }.no-active-title { margin-bottom: 5rpx; color: #1f2937; font-size: 26rpx; font-weight: 800; }.no-active-card .muted { font-size: 21rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 32rpx; }.section-head .section-title { margin: 0; color: #1f2937; font-size: 31rpx; }.section-caption { margin-top: 5rpx; color: #667085; font-size: 21rpx; }.view-all { padding: 12rpx 0 4rpx 18rpx; color: #1677e8; font-size: 22rpx; font-weight: 700; }
.upcoming-scroll { margin-top: 16rpx; white-space: nowrap; }.upcoming-card { box-sizing: border-box; display: inline-block; width: 440rpx; margin-right: 16rpx; padding: 23rpx; border: 1rpx solid #dce9ee; border-radius: 24rpx; background: #fff; vertical-align: top; }.upcoming-top { display: flex; justify-content: space-between; color: #1677e8; font-size: 20rpx; font-weight: 700; }.upcoming-top text:last-child { color: #667085; font-weight: 500; }.upcoming-title { overflow: hidden; margin-top: 14rpx; color: #07517a; font-size: 29rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.upcoming-date { margin-top: 8rpx; color: #667085; font-size: 20rpx; }.upcoming-arrow { margin-top: 18rpx; color: #1677e8; font-size: 21rpx; font-weight: 700; }.section-empty { margin-top: 16rpx; padding: 30rpx; border: 1rpx dashed #cbdfe7; border-radius: 22rpx; text-align: center; color: #39718b; background: rgba(255,255,255,.7); font-size: 23rpx; }
.quick-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 13rpx; margin-top: 25rpx; }.quick-card { display: flex; align-items: center; gap: 12rpx; min-width: 0; padding: 18rpx 14rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(7,81,122,.055); }.quick-icon { flex: 0 0 52rpx; height: 52rpx; border-radius: 16rpx; line-height: 52rpx; text-align: center; font-size: 22rpx; font-weight: 800; }.quick-icon.blue { color: #1677e8; background: #e7f2ff; }.quick-icon.orange { color: #d76519; background: #fff0df; }.quick-icon.green { color: #168f70; background: #dff7ef; }.quick-value { color: #1f2937; font-size: 28rpx; font-weight: 800; }.quick-label { margin-top: 2rpx; color: #667085; font-size: 18rpx; white-space: nowrap; }
.recent-card { display: flex; align-items: center; margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #dce9ee; border-radius: 24rpx; background: #fff; }.recent-mark { flex: 0 0 64rpx; height: 64rpx; margin-right: 17rpx; border-radius: 20rpx; line-height: 64rpx; text-align: center; color: #168f70; background: #dcfae6; font-size: 31rpx; font-weight: 800; }.recent-main { flex: 1; min-width: 0; }.recent-kicker { color: #168f70; font-size: 19rpx; font-weight: 800; }.recent-title { overflow: hidden; margin: 5rpx 0; color: #1f2937; font-size: 27rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.recent-main .muted { font-size: 19rpx; }.recent-arrow { color: #1677e8; font-size: 40rpx; }
.city-head { margin-top: 34rpx; }.city-row { display: flex; gap: 14rpx; margin-top: 16rpx; }.city-card { flex: 1; min-width: 0; padding: 21rpx 14rpx; border: 1rpx solid #dce8ed; border-radius: 22rpx; background: #fff; text-align: center; }.city-pin { color: #ff902f; font-size: 27rpx; }.city-name { margin-top: 6rpx; color: #07517a; font-size: 29rpx; font-weight: 800; }.city-action { margin-top: 5rpx; color: #667085; font-size: 19rpx; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
