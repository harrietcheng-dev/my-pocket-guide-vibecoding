.home { overflow: hidden; padding: 24rpx 28rpx 56rpx; background: linear-gradient(180deg, #eefaff 0, #f8fcff 420rpx, #f7fbfd 100%); }
.welcome-row, .section-heading, .current { display: flex; align-items: center; justify-content: space-between; }
.welcome-title { color: #103b55; font-size: 42rpx; font-weight: 800; }
.weather-chip { padding: 12rpx 18rpx; border: 1rpx solid rgba(22, 135, 200, .12); border-radius: 999rpx; color: #31708f; background: rgba(255,255,255,.78); box-shadow: 0 8rpx 24rpx rgba(39,120,158,.08); font-size: 22rpx; }
.hero { position: relative; display: flex; align-items: center; min-height: 340rpx; margin-top: 26rpx; padding: 38rpx 30rpx; overflow: hidden; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.9); border-radius: 38rpx; background: linear-gradient(135deg, #cceffd 0%, #e7f8ff 55%, #fff4d9 100%); box-shadow: 0 20rpx 50rpx rgba(31,128,172,.15); }
.hero-copy-block { position: relative; z-index: 2; width: 57%; }
.hero-title { color: #0b4262; font-size: 40rpx; line-height: 1.34; font-weight: 800; }
.hero-title-second { margin-top: 0; }
.hero-copy { margin-top: 22rpx; color: #4f7185; font-size: 23rpx; line-height: 1.65; }
.avatar-slot { position: absolute; right: 18rpx; top: 50%; z-index: 2; width: 210rpx; height: 210rpx; overflow: hidden; border-radius: 30rpx; transform: translateY(-50%); }
.hero-glow { position: absolute; border-radius: 50%; background: rgba(255,255,255,.45); }
.glow-one { width: 230rpx; height: 230rpx; right: -40rpx; top: -70rpx; }
.glow-two { width: 120rpx; height: 120rpx; left: 260rpx; bottom: -45rpx; }
.create-button { display: flex; align-items: center; justify-content: center; height: 96rpx; margin: 26rpx 0 0; padding: 0 30rpx; box-sizing: border-box; border-radius: 26rpx; color: #fff; background: linear-gradient(100deg, #1688ee, #1269dc); box-shadow: 0 16rpx 32rpx rgba(22,119,232,.22); font-size: 30rpx; font-weight: 700; line-height: 1; }
.create-label { display: block; flex-shrink: 0; white-space: nowrap; line-height: 96rpx; }
.button-hover { opacity: .88; transform: scale(.99); }
.current { margin-top: 24rpx; }
.current-title { margin: 8rpx 0; color: #103b55; font-size: 32rpx; font-weight: 700; }
.arrow { color: #1677e8; font-size: 58rpx; }
.section-heading { margin: 42rpx 2rpx 20rpx; align-items: flex-end; }
.section-title { margin: 0; color: #183f56; font-size: 34rpx; font-weight: 800; }
.section-subtitle { margin-top: 7rpx; color: #8193a0; font-size: 22rpx; }
.city-list { display: flex; flex-direction: column; gap: 20rpx; }
.city-card { position: relative; display: flex; align-items: center; min-height: 166rpx; padding: 24rpx; overflow: hidden; box-sizing: border-box; border-radius: 28rpx; box-shadow: 0 12rpx 34rpx rgba(25,82,111,.09); }
.city-card.beijing { background: linear-gradient(110deg, #fff0e7, #fff9f3); }
.city-card.xian { background: linear-gradient(110deg, #f5ecff, #fbf8ff); }
.city-card.hangzhou { background: linear-gradient(110deg, #e3f8f2, #f4fcf9); }
.city-card-hover { opacity: .86; transform: translateX(4rpx); }
.city-pattern { position: absolute; right: -30rpx; top: -55rpx; width: 210rpx; height: 210rpx; border: 28rpx solid rgba(255,255,255,.35); border-radius: 50%; }
.city-icon { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin-right: 24rpx; border-radius: 24rpx; background: rgba(255,255,255,.7); font-size: 60rpx; }
.city-content { position: relative; z-index: 1; flex: 1; }
.city-name { color: #173f55; font-size: 34rpx; font-weight: 800; }
.city-slogan { margin-top: 5rpx; color: #6c7f8b; font-size: 23rpx; }
.city-action { margin-top: 15rpx; color: #1677e8; font-size: 23rpx; font-weight: 700; }
.city-action text { margin-left: 5rpx; }
.home-footer { margin-top: 36rpx; color: #9aabb5; font-size: 21rpx; letter-spacing: 2rpx; text-align: center; }
