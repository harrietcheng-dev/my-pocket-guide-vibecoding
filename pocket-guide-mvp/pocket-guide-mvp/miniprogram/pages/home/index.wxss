.home { overflow: hidden; padding: 24rpx 28rpx 56rpx; background: linear-gradient(180deg, #eefaff 0, #f8fcff 420rpx, #f7fbfd 100%); }
.welcome-row, .section-heading, .current { display: flex; align-items: center; justify-content: space-between; }
.welcome-title { color: #103b55; font-size: 42rpx; font-weight: 800; }
.weather-chip { padding: 12rpx 18rpx; border: 1rpx solid rgba(22, 135, 200, .12); border-radius: 999rpx; color: #31708f; background: rgba(255,255,255,.78); box-shadow: 0 8rpx 24rpx rgba(39,120,158,.08); font-size: 22rpx; }
.hero { position: relative; display: flex; align-items: center; min-height: 340rpx; margin-top: 26rpx; padding: 38rpx 30rpx; overflow: hidden; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.9); border-radius: 38rpx; background: linear-gradient(135deg, #cceffd 0%, #e7f8ff 55%, #fff4d9 100%); box-shadow: 0 20rpx 50rpx rgba(31,128,172,.15); }
.hero-copy-block { position: relative; z-index: 2; width: 57%; }
.hero-title { color: #0b4262; font-size: 40rpx; line-height: 1.34; font-weight: 800; }
.hero-title-second { margin-top: 0; }
.hero-copy { margin-top: 22rpx; color: #4f7185; font-size: 23rpx; line-height: 1.65; }
.avatar-slot { position: absolute; right: 18rpx; top: 50%; z-index: 2; width: 210rpx; height: 210rpx; overflow: hidden; border-radius: 30rpx; transform: translateY(-50%); }
.hero-glow { position: absolute; border-radius: 50%; background: rgba(255,255,255,.45); }
.glow-one { width: 230rpx; height: 230rpx; right: -40rpx; top: -70rpx; }
.glow-two { width: 120rpx; height: 120rpx; left: 260rpx; bottom: -45rpx; }
.create-button { display: flex; align-items: center; justify-content: center; height: 96rpx; margin: 26rpx 0 0; padding: 0 30rpx; box-sizing: border-box; border-radius: 26rpx; color: #fff; background: linear-gradient(100deg, #1688ee, #1269dc); box-shadow: 0 16rpx 32rpx rgba(22,119,232,.22); font-size: 30rpx; font-weight: 700; line-height: 1; }
.create-label { display: block; flex-shrink: 0; white-space: nowrap; line-height: 96rpx; }
.button-hover { opacity: .88; transform: scale(.99); }
.current { margin-top: 24rpx; }
.current-title { margin: 8rpx 0; color: #103b55; font-size: 32rpx; font-weight: 700; }
.arrow { color: #1677e8; font-size: 58rpx; }
.section-heading { margin: 42rpx 2rpx 20rpx; align-items: flex-end; }
.section-title { margin: 0; color: #183f56; font-size: 34rpx; font-weight: 800; }
.section-subtitle { margin-top: 7rpx; color: #8193a0; font-size: 22rpx; }
.city-list { display: flex; flex-direction: column; gap: 20rpx; }
.city-card { position: relative; display: flex; align-items: center; min-height: 166rpx; padding: 24rpx; overflow: hidden; box-sizing: border-box; border-radius: 28rpx; box-shadow: 0 12rpx 34rpx rgba(25,82,111,.09); }
.city-card.beijing { background: linear-gradient(110deg, #fff0e7, #fff9f3); }
.city-card.xian { background: linear-gradient(110deg, #f5ecff, #fbf8ff); }
.city-card.hangzhou { background: linear-gradient(110deg, #e3f8f2, #f4fcf9); }
.city-card-hover { opacity: .86; transform: translateX(4rpx); }
.city-pattern { position: absolute; right: -30rpx; top: -55rpx; width: 210rpx; height: 210rpx; border: 28rpx solid rgba(255,255,255,.35); border-radius: 50%; }
.city-icon { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; margin-right: 24rpx; border-radius: 24rpx; background: rgba(255,255,255,.7); font-size: 60rpx; }
.city-content { position: relative; z-index: 1; flex: 1; }
.city-name { color: #173f55; font-size: 34rpx; font-weight: 800; }
.city-slogan { margin-top: 5rpx; color: #6c7f8b; font-size: 23rpx; }
.city-action { margin-top: 15rpx; color: #1677e8; font-size: 23rpx; font-weight: 700; }
.city-action text { margin-left: 5rpx; }
.home-footer { margin-top: 36rpx; color: #9aabb5; font-size: 21rpx; letter-spacing: 2rpx; text-align: center; }

.dashboard-loading { margin-top: 22rpx; }
.dashboard-loading view { height: 110rpx; margin-top: 14rpx; border-radius: 24rpx; background: linear-gradient(90deg,#e8f1f4 25%,#f7fafb 38%,#e8f1f4 63%); background-size: 400% 100%; animation: shimmer 1.4s ease infinite; }
.dashboard-loading view:first-child { height: 280rpx; }
.dashboard-error { display: flex; justify-content: space-between; margin-top: 22rpx; padding: 24rpx; border-radius: 20rpx; color: #b54708; background: #fff4e8; font-size: 23rpx; }
.dashboard-error text:last-child { color: #1677e8; font-weight: 800; }
.active-trip-card { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid #cde5ef; border-radius: 30rpx; background: #fff; box-shadow: 0 15rpx 36rpx rgba(7,81,122,.09); }
.active-card-head { display: flex; justify-content: space-between; gap: 20rpx; }
.active-kicker { color: #168f70; font-size: 21rpx; font-weight: 800; }
.active-kicker text { display: inline-block; width: 13rpx; height: 13rpx; margin-right: 7rpx; border-radius: 50%; background: #20a77a; }
.active-title { margin-top: 9rpx; color: #07517a; font-size: 35rpx; font-weight: 800; }
.active-date { margin-top: 6rpx; color: #667085; font-size: 21rpx; }
.progress-number { color: #1677e8; font-size: 35rpx; font-weight: 800; }
.active-progress { height: 12rpx; margin-top: 23rpx; overflow: hidden; border-radius: 999rpx; background: #e2edf2; }
.active-progress view { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg,#20a77a,#1677e8); }
.active-progress-meta { display: flex; justify-content: space-between; margin-top: 9rpx; color: #667085; font-size: 20rpx; }
.next-stop { display: flex; align-items: center; margin-top: 22rpx; padding: 18rpx; border-radius: 20rpx; background: #f2fafb; }
.next-stop-icon { flex: 0 0 58rpx; height: 58rpx; margin-right: 15rpx; border-radius: 18rpx; line-height: 58rpx; text-align: center; color: #1677e8; background: #e2f1ff; font-size: 29rpx; }
.next-stop-main { flex: 1; }
.next-stop-main view { color: #667085; font-size: 19rpx; }
.next-stop-main text { display: block; margin-top: 4rpx; color: #1f2937; font-size: 27rpx; font-weight: 800; }
.next-stop-time { color: #39718b; font-size: 20rpx; }
.continue-button { height: 76rpx; margin-top: 20rpx; border-radius: 18rpx; line-height: 76rpx; color: #fff; background: #1677e8; font-size: 26rpx; font-weight: 700; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 32rpx; }
.section-head .section-title { margin: 0; color: #1f2937; font-size: 31rpx; }
.section-caption { margin-top: 5rpx; color: #667085; font-size: 21rpx; }
.view-all { padding: 12rpx 0 4rpx 18rpx; color: #1677e8; font-size: 22rpx; font-weight: 700; }
.upcoming-scroll { margin-top: 16rpx; white-space: nowrap; }
.upcoming-card { box-sizing: border-box; display: inline-block; width: 440rpx; margin-right: 16rpx; padding: 23rpx; border: 1rpx solid #dce9ee; border-radius: 24rpx; background: #fff; vertical-align: top; }
.upcoming-top { display: flex; justify-content: space-between; color: #1677e8; font-size: 20rpx; font-weight: 700; }
.upcoming-top text:last-child { color: #667085; font-weight: 500; }
.upcoming-title { overflow: hidden; margin-top: 14rpx; color: #07517a; font-size: 29rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.upcoming-date { margin-top: 8rpx; color: #667085; font-size: 20rpx; }
.upcoming-arrow { margin-top: 18rpx; color: #1677e8; font-size: 21rpx; font-weight: 700; }
.section-empty { margin-top: 16rpx; padding: 30rpx; border: 1rpx dashed #cbdfe7; border-radius: 22rpx; text-align: center; color: #39718b; background: rgba(255,255,255,.7); font-size: 23rpx; }
.quick-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 13rpx; margin-top: 25rpx; }
.quick-card { display: flex; align-items: center; gap: 12rpx; min-width: 0; padding: 18rpx 14rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(7,81,122,.055); }
.quick-icon { flex: 0 0 52rpx; height: 52rpx; border-radius: 16rpx; line-height: 52rpx; text-align: center; font-size: 22rpx; font-weight: 800; }
.quick-icon.blue { color: #1677e8; background: #e7f2ff; }
.quick-icon.orange { color: #d76519; background: #fff0df; }
.quick-icon.green { color: #168f70; background: #dff7ef; }
.quick-value { color: #1f2937; font-size: 28rpx; font-weight: 800; }
.quick-label { margin-top: 2rpx; color: #667085; font-size: 18rpx; white-space: nowrap; }
.recent-card { display: flex; align-items: center; margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #dce9ee; border-radius: 24rpx; background: #fff; }
.recent-mark { flex: 0 0 64rpx; height: 64rpx; margin-right: 17rpx; border-radius: 20rpx; line-height: 64rpx; text-align: center; color: #168f70; background: #dcfae6; font-size: 31rpx; font-weight: 800; }
.recent-main { flex: 1; min-width: 0; }
.recent-kicker { color: #168f70; font-size: 19rpx; font-weight: 800; }
.recent-title { overflow: hidden; margin: 5rpx 0; color: #1f2937; font-size: 27rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.recent-main .muted { font-size: 19rpx; }
.recent-arrow { color: #1677e8; font-size: 40rpx; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
