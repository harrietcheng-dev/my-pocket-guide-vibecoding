<view class="page home">
  <view class="hero card">
    <view class="avatar-shell">
      <view class="avatar-face">光</view>
      <view class="avatar-state">光墩墩 · {{avatarState}}</view>
    </view>
    <view class="title">你好，我是你的口袋导游</view>
    <view class="muted hero-copy">告诉我想去哪里，我会把路线、时间和预算整理成一份可执行行程。</view>
    <button class="primary-button" bindtouchstart="holdToTalk" bindtouchend="stopTalk">按住说话</button>
    <button class="secondary-button" bindtap="createTrip">创建新行程</button>
  </view>

  <view wx:if="{{currentTrip}}" class="current card" bindtap="continueTrip">
    <view>
      <view class="status">当前行程</view>
      <view class="current-title">{{currentTrip.title}}</view>
      <view class="muted">版本 {{currentTrip.version}} · 点击继续</view>
    </view>
    <view class="arrow">›</view>
  </view>

  <view class="section-title">热门城市</view>
  <view class="city-row">
    <view wx:for="{{cities}}" wx:key="*this" class="city-card" data-city="{{item}}" bindtap="chooseCity">
      <view class="city-name">{{item}}</view>
      <view class="muted">开始规划</view>
    </view>
  </view>
</view>
