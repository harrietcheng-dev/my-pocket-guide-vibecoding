<view class="page library-page">
  <view class="library-head">
    <view class="library-title">我的旅行收藏</view>
    <view class="muted">把喜欢的地点和旅途见闻留在这里</view>
  </view>
  <view class="library-stats"><view><text>{{favorites.length}}</text><text>收藏地点</text></view><view><text>{{notes.length}}</text><text>旅行笔记</text></view></view>
  <view class="library-tabs"><view class="library-tab {{tab === 'favorites' ? 'active' : ''}}" data-tab="favorites" bindtap="selectTab">收藏</view><view class="library-tab {{tab === 'notes' ? 'active' : ''}}" data-tab="notes" bindtap="selectTab">旅行笔记</view></view>

  <block wx:if="{{tab === 'favorites'}}">
    <view wx:for="{{favorites}}" wx:key="id" class="library-card">
      <view class="library-card-main" data-id="{{item.id}}" bindtap="openFavorite"><view class="library-icon favorite-icon">★</view><view class="library-content"><view class="library-name">{{item.name}}</view><view class="library-meta">{{item.type}} · {{item.tripTitle || '独立收藏'}}</view><view wx:if="{{item.reason}}" class="library-copy">{{item.reason}}</view><view class="library-date">收藏于 {{item.displayDate}}</view></view><view class="library-arrow">›</view></view>
      <view class="remove-link" data-id="{{item.id}}" bindtap="removeFavorite">取消收藏</view>
    </view>
    <view wx:if="{{!favorites.length}}" class="library-empty"><view class="empty-symbol">☆</view><view class="empty-title">还没有收藏地点</view><view class="muted">在行程节点点击“收藏地点”，以后可以从这里快速找到。</view><button bindtap="goTrips">去行程中看看</button></view>
  </block>

  <block wx:else>
    <view wx:for="{{notes}}" wx:key="id" class="library-card note-card"><view class="note-card-head"><view><view class="library-name">{{item.placeName}}</view><view class="library-meta">{{item.tripTitle}}</view></view><view class="library-date">{{item.displayDate}}</view></view><view class="note-copy">{{item.text}}</view><view class="note-card-actions"><text data-id="{{item.id}}" bindtap="openNoteTrip">查看所在行程</text><text class="danger" data-id="{{item.id}}" bindtap="removeNote">删除</text></view></view>
    <view wx:if="{{!notes.length}}" class="library-empty"><view class="empty-symbol">✎</view><view class="empty-title">还没有旅行笔记</view><view class="muted">完成一个行程节点后，就可以记录当时的见闻和感受。</view><button bindtap="goTrips">查看我的行程</button></view>
  </block>
</view>
