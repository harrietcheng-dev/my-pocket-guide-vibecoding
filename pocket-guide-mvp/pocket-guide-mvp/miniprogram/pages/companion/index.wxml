<view class="companion-page">
  <view class="sky-glow sky-glow-one"></view>
  <view class="sky-glow sky-glow-two"></view>

  <view class="page-head">
    <view>
      <view class="eyebrow">POCKET GUIDE · ON TRIP</view>
      <view class="page-title">在途陪伴</view>
      <view class="page-subtitle">像导游一样，随时在你身边</view>
    </view>
    <view class="head-status"><view class="status-dot"></view>{{speechState}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading-shell">
    <view class="skeleton skeleton-hero"></view>
    <view class="skeleton skeleton-card"></view>
  </view>

  <block wx:elif="{{trip}}">
    <view class="hero-card">
      <view class="hero-topline">
        <view class="location-pill">⌖ {{currentNode ? currentNode.name : trip.title}}</view>
        <view class="trip-pill">{{trip.state === 'ACTIVE' ? '行程中' : '待出发'}}</view>
      </view>

      <view class="scene">
        <view class="sun"></view>
        <view class="mountain mountain-back"></view>
        <view class="mountain mountain-front"></view>
        <view class="palace"><view class="palace-roof"></view><view class="palace-body"></view></view>
        <view class="guide-avatar">
          <view class="avatar-halo"></view>
          <view class="avatar-head">光</view>
          <view class="avatar-body"></view>
          <view class="avatar-tag">光墩墩 · {{speechState}}</view>
        </view>
      </view>

      <view class="guide-bubble">
        <view class="bubble-kicker">到达景点 · 自动讲解</view>
        <view class="guide-text">{{guide ? guide.text : (currentNode ? '到达并签到后，我会用 30–60 秒介绍这里最值得看的背景、亮点和参观提醒。' : '准备开始今天的旅程。')}}</view>
        <view wx:if="{{guide}}" class="guide-meta" bindtap="toggleSource">
          <text>{{guide.confidence === 'PARTIAL' ? '部分校验' : '已校验'}} · {{guide.durationSec}} 秒</text>
          <text>{{showSource ? '收起来源' : '查看来源'}} ›</text>
        </view>
        <block wx:if="{{guide}}"><view wx:if="{{showSource}}" class="source-row">{{guide.sourceTitle}} · 更新于 {{guide.fetchedAt}}</view></block>
      </view>

      <view class="audio-bar">
        <view class="audio-play" bindtap="toggleExplain">{{explaining ? 'Ⅱ' : '▶'}}</view>
        <view class="wave-track"><view class="wave-progress" style="width: {{audioProgress}}%"></view></view>
        <view class="audio-time">{{guide ? guide.durationSec : 42}}s</view>
      </view>

      <view class="hero-actions">
        <button class="hero-action primary" loading="{{checkingIn}}" bindtap="checkIn">{{currentNode.status === 'IN_PROGRESS' ? '已到达' : '手动签到'}}</button>
        <button class="hero-action" bindtap="detailedGuide">详细讲讲</button>
        <button class="hero-action icon-action" bindtap="toggleSource">ⓘ</button>
      </view>
    </view>

    <view class="route-card">
      <view class="route-map">
        <view class="route-line"></view>
        <view class="map-road road-one"></view>
        <view class="map-road road-two"></view>
        <view class="map-pin current-pin">我</view>
        <view class="map-pin target-pin">终</view>
      </view>
      <view class="route-info">
        <view class="route-label">接下来参观</view>
        <view class="route-title">{{nextNode ? nextNode.name : '今日行程已接近完成'}}</view>
        <view class="route-meta">{{nextNode ? ('约 ' + nextNode.durationMin + ' 分钟停留') : '可以继续提问或结束行程'}}</view>
        <view class="route-buttons">
          <button class="map-button" bindtap="openMap">查看地图</button>
          <button class="nav-button" bindtap="startNavigation">开始导航</button>
        </view>
      </view>
    </view>

    <view class="section-block">
      <view class="section-head"><view><view class="section-title">周边服务</view><view class="section-subtitle">主动获取位置时才会刷新距离</view></view></view>
      <scroll-view class="service-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="service-row">
          <view wx:for="{{serviceItems}}" wx:key="key" class="service-item" data-category="{{item.key}}" bindtap="chooseService">
            <view class="service-icon {{item.tone}}">{{item.icon}}</view>
            <view class="service-label">{{item.label}}</view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{nearbyTitle}}" class="nearby-panel">
        <view class="nearby-title">{{nearbyTitle}} <text>演示距离</text></view>
        <view wx:if="{{!nearbyItems.length}}" class="nearby-loading">正在查找附近地点…</view>
        <view wx:for="{{nearbyItems}}" wx:key="id" class="nearby-item" data-item="{{item}}" bindtap="openNearby">
          <view class="nearby-main"><view class="nearby-name">{{item.name}}</view><view class="nearby-type">{{item.type}}</view></view>
          <view class="nearby-distance">{{item.distanceM >= 1000 ? (item.distanceM / 1000 + ' km') : (item.distanceM + ' m')}} ›</view>
        </view>
      </view>
    </view>

    <view class="section-block conversation-block">
      <view class="section-head conversation-head">
        <view><view class="section-title">随时提问</view><view class="section-subtitle">景点、路线、周边和调整都可以问</view></view>
        <view class="replan-link" bindtap="replan">调整行程 ›</view>
      </view>

      <view class="message-list">
        <view wx:for="{{messages}}" wx:key="id" class="message-row {{item.role}}">
          <view wx:if="{{item.role === 'assistant'}}" class="mini-avatar">光</view>
          <view class="message-bubble">{{item.text}}</view>
        </view>
        <view wx:if="{{asking}}" class="message-row assistant"><view class="mini-avatar">光</view><view class="message-bubble typing">正在整理回答 <text>•••</text></view></view>
      </view>

      <scroll-view class="quick-scroll" scroll-x="true" show-scrollbar="false">
        <view class="quick-row"><view wx:for="{{quickQuestions}}" wx:key="*this" class="quick-chip" data-question="{{item}}" bindtap="quickAsk">{{item}}</view></view>
      </scroll-view>

      <view class="input-dock">
        <view class="voice-button {{recording ? 'recording' : ''}}" bindtouchstart="startVoice" bindtouchend="endVoice" bindtouchcancel="cancelVoice">{{recording ? '◼' : '●'}}</view>
        <input class="question-input" value="{{question}}" bindinput="inputQuestion" confirm-type="send" bindconfirm="ask" placeholder="有什么问题尽管问我…" />
        <view class="send-button {{question ? 'active' : ''}}" bindtap="ask">发送</view>
      </view>
      <view class="voice-tip">按住圆点说话；当前为语音转文字演示模式</view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <view class="empty-illustration"><view class="empty-pocket">光</view></view>
    <view class="empty-title">还没有可陪伴的行程</view>
    <view class="empty-copy">先创建一份行程，到达景点后即可签到、听讲解、问路线和灵活调整。</view>
    <button class="create-button" bindtap="createTrip">创建新行程</button>
  </view>
</view>
