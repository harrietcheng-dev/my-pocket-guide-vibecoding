<view class="page">
  <view class="title">我的行程</view>
  <view wx:if="{{trips.length}}" class="trip-list">
    <view wx:for="{{trips}}" wx:key="id" class="trip card" data-id="{{item.id}}" bindtap="open">
      <view class="trip-main">
        <view class="trip-title">{{item.title}}</view>
        <view class="muted">{{item.constraints.startDate}} 至 {{item.constraints.endDate}}</view>
        <view class="meta">{{item.constraints.partySize}} 人 · ¥{{item.constraints.groupBudgetCny}} · {{item.constraints.pace}}</view>
      </view>
      <view class="status">{{item.state === 'READY' ? '待出发' : item.state}}</view>
    </view>
  </view>
  <view wx:else class="empty card">
    <view>还没有行程</view>
    <button class="primary-button" bindtap="create">创建第一份行程</button>
  </view>
</view>
