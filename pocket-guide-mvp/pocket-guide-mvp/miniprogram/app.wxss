page {
  background: #f7fbfd;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 48rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #dce8ed;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(7, 81, 122, 0.06);
}

.title {
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 700;
}

.section-title {
  margin: 32rpx 0 18rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.muted {
  color: #667085;
}

.primary-button,
.secondary-button,
.accent-button {
  margin: 20rpx 0 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button {
  color: #ffffff;
  background: #1677e8;
}

.secondary-button {
  color: #07517a;
  background: #eaf7fb;
}

.accent-button {
  color: #ffffff;
  background: #ff902f;
}

.pill {
  display: inline-flex;
  align-items: center;
  margin: 8rpx 12rpx 8rpx 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #07517a;
  background: #eaf7fb;
  font-size: 24rpx;
}

.status {
  color: #ff902f;
  font-size: 24rpx;
  font-weight: 600;
}

.empty {
  padding: 90rpx 30rpx;
  text-align: center;
  color: #667085;
}

button::after {
  border: 0;
}
